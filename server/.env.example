PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins (no trailing slash needed)
CLIENT_URL=http://localhost:5173
# Optional in production: 'none' (default, for separate frontend/backend domains) or 'lax' (same-origin)
COOKIE_SAMESITE=lax
JWT_SECRET=replace_with_a_long_random_secret_string
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
